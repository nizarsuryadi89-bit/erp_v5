    public function penilaian_kinerja()
    {
        // Get filter parameters
        $bulan = $this->input->get('bulan') ?: date('Y-m');
        $karyawan_id = $this->input->get('karyawan_id') ?: '';
        $jabatan_id = $this->input->get('jabatan_id') ?: '';

        $range = $this->_get_payroll_range($bulan);

        $extra_data = array(
            'performance_data' => $this->get_performance_data($bulan, $karyawan_id, $jabatan_id, $range['start'], $range['end']),
            'stats' => $this->get_performance_stats($bulan),
            'karyawan_list' => $this->db->where('divisi_id !=', 8)->where_not_in('jabatan_id', [1, 2, 3])->get('tbl_karyawan')->result(),
            'jabatan_list' => $this->db->get('tbl_jabatan')->result(),
            'bulan' => $bulan,
            'karyawan_id' => $karyawan_id,
            'jabatan_id' => $jabatan_id,
            'perusahaan' => ($this->session->userdata('perusahaan_id') == 1 || $this->session->userdata('level') == 1 || $this->session->userdata('level') == 21) ? 'Semua Perusahaan' : $this->db->get_where('tbl_perusahaan', ['id_perusahaan' => $this->session->userdata('perusahaan_id')])->row('nama_perusahaan'),
        );

        $data = $this->_prepare_view_data('Penilaian Kinerja Karyawan', $extra_data);
        $this->load_admin_view('admin/karyawan/penilaian_kinerja', $data);
    }

    /**
     * Get performance data for employees (Attendance-Based)
     */
    private function get_performance_data($bulan, $karyawan_id = '', $jabatan_id = '', $start_date = '', $end_date = '')
    {
        if (empty($start_date)) {
            $start_date = $bulan . '-01';
            $end_date = date('Y-m-t', strtotime($start_date));
        }
        $this->db->select('
                k.karyawan_id,
                k.nama_lengkap,
                k.nik,
                j.nama_jabatan,
                o.operator_nama as divisi_nama,
                p.nama_perusahaan,
                COUNT(CASE WHEN a.status = "Hadir" THEN 1 END) as total_hadir,
                COUNT(CASE WHEN a.status = "Sakit" THEN 1 END) as total_sakit,
                COUNT(CASE WHEN a.status = "Izin" THEN 1 END) as total_izin,
            COUNT(CASE WHEN a.status LIKE "Cuti%" THEN 1 END) as total_cuti,
            COUNT(CASE WHEN a.status = "Hadir" AND a.jam_masuk > "08:00:00" THEN 1 END) as total_telat,
        SUM(CASE WHEN a.status = "Hadir" AND a.jam_masuk > "08:00:00" THEN TIME_TO_SEC(TIMEDIFF(a.jam_masuk, "08:00:00")) ELSE 0 END) as total_detik_telat,
        COUNT(CASE WHEN a.status = "Hadir" AND a.jam_pulang < "17:00:00" AND a.jam_pulang != "00:00:00" THEN 1 END) as total_pulang_cepat
        ');
        $this->db->from('tbl_karyawan k');
        $this->db->join('tbl_jabatan j', 'j.jabatan_id = k.jabatan_id', 'left');
        $this->db->join('tbl_operator o', 'o.operator_id = k.divisi_id', 'left');
        $this->db->join('tbl_perusahaan p', 'p.id_perusahaan = k.perusahaan_id', 'left');
        $this->db->join('absensi a', 'a.karyawan_id = k.karyawan_id AND a.tanggal >= "' . $start_date . '" AND a.tanggal <= "' . $end_date . '"', 'left');

        // Exclude Owner and Directors from performance data
        $this->db->where('k.divisi_id !=', 8);
        $this->db->where_not_in('k.jabatan_id', [1, 2, 3]);
        $this->db->where('k.nama_lengkap NOT LIKE', '%Terminal%');

        // Apply filters
        if ($karyawan_id) {
            $this->db->where('k.karyawan_id', $karyawan_id);
        }
        if ($jabatan_id) {
            $this->db->where('k.jabatan_id', $jabatan_id);
        }



        $this->db->group_by('k.karyawan_id, k.nama_lengkap, k.nik, j.nama_jabatan, o.operator_nama, p.nama_perusahaan');
        $result = $this->db->get()->result();

        // Calculate Working Days (Mon-Sat, excluding holidays)
        $workingDays = $this->get_working_days($bulan, $start_date, $end_date);

        // Process data for Alpha and Score calculations
        foreach ($result as $row) {
            $total_recorded = $row->total_hadir + $row->total_izin + $row->total_sakit + $row->total_cuti;
            $calculated_alpha = max(0, $workingDays - $total_recorded);
            $row->total_alpha = $calculated_alpha;

            // Scoring logic based on provided criteria:
            // Alpha: -5, Izin: -1, Sakit: -1, Telat: -1, Pulang Cepat: -3
            $score = 100 - ($row->total_sakit * 1) - ($row->total_izin * 1) - ($calculated_alpha * 5) - ($row->total_telat * 1) - ($row->total_pulang_cepat * 3);
            $row->skor_kinerja = $score;
        }

        // Sort by Score DESC
        usort($result, function ($a, $b) {
            return $b->skor_kinerja <=> $a->skor_kinerja;
        });

        return $result;
    }

    /**
     * Get aggregated performance statistics
     */
    private function get_performance_stats($bulan)
    {
        $range = $this->_get_payroll_range($bulan);
        $performance_data = $this->get_performance_data($bulan, '', '', $range['start'], $range['end']);

        $total_employees = count($performance_data);
        $total_hadir = 0;
        $total_telat = 0;
        $total_alpha = 0;
        $total_sakit = 0;
        $total_izin = 0;
        $total_score = 0;

        foreach ($performance_data as $perf) {
            $total_hadir += $perf->total_hadir;
            $total_telat += $perf->total_telat;
            $total_alpha += $perf->total_alpha;
            $total_sakit += $perf->total_sakit;
            $total_izin += $perf->total_izin;
            $total_score += $perf->skor_kinerja;
        }

        $avg_score = $total_employees > 0 ? $total_score / $total_employees : 0;

        return array(
            'total_employees' => $total_employees,
            'total_hadir' => $total_hadir,
            'total_telat' => $total_telat,
            'total_alpha' => $total_alpha,
            'total_sakit' => $total_sakit,
            'total_izin' => $total_izin,
            'avg_score' => round($avg_score, 2)
        );
    }

    private function get_working_days($bulan, $start_date = '', $end_date = '')
    {
        if (empty($start_date)) {
            $start_date = $bulan . '-01';
            $end_date = date('Y-m-t', strtotime($start_date));
        }

        // Get Holidays
        $this->db->select('tanggal');
        $this->db->where('tanggal >=', $start_date);
        $this->db->where('tanggal <=', $end_date);
        $holidays = $this->db->get('hari_libur')->result_array();
        $holiday_dates = array_column($holidays, 'tanggal');

        $workingDays = 0;
        $today = date('Y-m-d');

        $current = strtotime($start_date);
        $last = strtotime($end_date);

        while ($current <= $last) {
            $date = date('Y-m-d', $current);
            if ($date > $today) {
                break;
            }

            $dayOfWeek = date('N', $current); // 1 (Mon) to 7 (Sun)
            if ($dayOfWeek <= 6 && !in_array($date, $holiday_dates)) { // Mon-Sat, not holiday
                $workingDays++;
            }
            $current = strtotime('+1 day', $current);
        }
        return $workingDays;


        /**
         * Get performance statistics (Attendance-Based)
         */
        $range = $this->_get_payroll_range($bulan);
        $start_date = $range['start'];
        $end_date = $range['end'];

        // Total active employees this month
        $this->db->select('COUNT(DISTINCT k.karyawan_id) as total_karyawan_aktif');
        $this->db->from('absensi');
        $this->db->where('tanggal >=', $start_date);
        $this->db->where('tanggal <=', $end_date);
        $this->db->where('status', 'Hadir');
        $this->db->join('tbl_karyawan k', 'k.karyawan_id = absensi.karyawan_id');
        $this->db->where('k.divisi_id !=', 8);
        $this->db->where_not_in('k.jabatan_id', [1, 2, 3]);
        if ($this->session->userdata('logged_in')) {
            if ($this->session->userdata('perusahaan_id') != 1 && $this->session->userdata('level') != 1 && $this->session->userdata('level') != 21) {
                $this->db->join('tbl_karyawan', 'tbl_karyawan.karyawan_id = absensi.karyawan_id');
                $this->db->where('tbl_karyawan.perusahaan_id', $this->session->userdata('perusahaan_id'));
            }
        }
        $total_active = $this->db->get()->row()->total_karyawan_aktif;

        // Total Late
        $this->db->select('COUNT(*) as total_telat');
        $this->db->from('absensi');
        $this->db->where('tanggal >=', $start_date);
        $this->db->where('tanggal <=', $end_date);
        $this->db->where('status', 'Hadir');
        $this->db->join('tbl_karyawan k', 'k.karyawan_id = absensi.karyawan_id');
        $this->db->where('k.divisi_id !=', 8);
        $this->db->where_not_in('k.jabatan_id', [1, 2, 3]);
        $this->db->where('jam_masuk >', '08:00:00');
        if ($this->session->userdata('logged_in')) {
            if ($this->session->userdata('perusahaan_id') != 1 && $this->session->userdata('level') != 1 && $this->session->userdata('level') != 21) {
                $this->db->join('tbl_karyawan', 'tbl_karyawan.karyawan_id = absensi.karyawan_id');
                $this->db->where('tbl_karyawan.perusahaan_id', $this->session->userdata('perusahaan_id'));
            }
        }
        $total_late = $this->db->get()->row()->total_telat;

        // Average Discipline Score and Top Score
        $performance_data = $this->get_performance_data($bulan, '', '', $start_date, $end_date);
        $total_score = 0;
        $max_score = 0;

        foreach ($performance_data as $row) {
            $total_score += $row->skor_kinerja;
            if ($row->skor_kinerja > $max_score) {
                $max_score = $row->skor_kinerja;
            }
        }

        $avg_score = count($performance_data) > 0 ? round($total_score / count($performance_data), 1) : 0;

        return array(
            'total_karyawan_aktif' => $total_active,
            'total_telat' => $total_late,
            'rata_rata_skor' => $avg_score,
            'top_score' => $max_score
        );
    }

    /**
     * Get detailed activity for specific employee
     */
    public function detail_kinerja($karyawan_id)
    {
        $bulan = $this->input->get('bulan') ?: date('Y-m');

        $extra_data = array(
            'karyawan' => $this->db->select('k.*, j.nama_jabatan, o.operator_nama as divisi_nama, p.nama_perusahaan')
                ->from('tbl_karyawan k')
                ->join('tbl_jabatan j', 'j.jabatan_id = k.jabatan_id', 'left')
                ->join('tbl_operator o', 'o.operator_id = k.divisi_id', 'left')
                ->join('tbl_perusahaan p', 'p.id_perusahaan = k.perusahaan_id', 'left')
                ->where('k.karyawan_id', $karyawan_id)
                ->get()->row(),
            'attendance_history' => $this->db->select('*')
                ->from('absensi')
                ->where('karyawan_id', $karyawan_id)
                ->where('DATE_FORMAT(tanggal, "%Y-%m") =', $bulan)
                ->order_by('tanggal', 'ASC')
                ->get()->result(),
            'bulan' => $bulan,
        );

        $data = $this->_prepare_view_data('Detail Kinerja Karyawan', $extra_data);
        $this->load_admin_view('admin/karyawan/detail_kinerja', $data);
    }

    /**
     * Export performance data to Excel
     */
    public function export_kinerja_excel()
    {
        $bulan = $this->input->get('bulan') ? $this->input->get('bulan') : date('Y-m');
        $karyawan_id = $this->input->get('karyawan_id') ? $this->input->get('karyawan_id') : '';
        $jabatan_id = $this->input->get('jabatan_id') ? $this->input->get('jabatan_id') : '';

        $range = $this->_get_payroll_range($bulan);
        $performance_data = $this->get_performance_data($bulan, $karyawan_id, $jabatan_id, $range['start'], $range['end']);

        // Set headers for Excel download
        header('Content-Type: application/vnd.ms-excel');
        header('Content-Disposition: attachment; filename="laporan_kinerja_' . $bulan . '.xls"');

        $this->load->view('admin/karyawan/export_kinerja_excel', array(
            'performance_data' => $performance_data,
            'bulan' => $bulan
        ));
    }

    /**
     * Print performance report for specific employee
     */
    public function cetak_kinerja($karyawan_id)
    {
        $bulan = $this->input->get('bulan') ?: date('Y-m');
        $this->load->model('Absensi_model');

        $perf_data = $this->get_performance_data($bulan, $karyawan_id);

        if (empty($perf_data)) {
            show_404();
        }

        // Fetch company logo and details
        $perf = $perf_data[0];
        $karyawan = $this->db->get_where('tbl_karyawan', ['karyawan_id' => $karyawan_id])->row();
        $perusahaan = $this->db->get_where('tbl_perusahaan', ['id_perusahaan' => $karyawan->perusahaan_id])->row();

        $extra_data = array(
            'perf' => $perf,
            'bulan' => $bulan,
            'perusahaan' => $perusahaan
        );

        $this->load->view('admin/karyawan/cetak_laporan_kinerja', $extra_data);
    }

    /**
     * Salary calculation application
     */
    public function penggajian()
    {
        // Get filter parameters
        $bulan = $this->input->get('bulan') ?: date('Y-m');
        $karyawan_id = $this->input->get('karyawan_id') ?: '';
        $jabatan_id = $this->input->get('jabatan_id') ?: '';

        // Exclude Owner and Directors from list
        $this->db->where('k.divisi_id !=', 8);
        $this->db->where_not_in('k.jabatan_id', [1, 2, 3]);
        $karyawan_list = $this->M_master->get_karyawan()->result();

        $extra_data = array(
            'salary_data' => $this->get_salary_data($bulan, $karyawan_id, $jabatan_id),
            'salary_stats' => $this->get_salary_stats($bulan),
            'karyawan_list' => $karyawan_list,
            'jabatan_list' => $this->db->get('tbl_jabatan')->result(),
            'bulan' => $bulan,
            'karyawan_id' => $karyawan_id,
            'jabatan_id' => $jabatan_id,
            'payroll_range' => $this->_get_payroll_range($bulan),
        );

        $data = $this->_prepare_view_data('Sistem Penggajian Karyawan', $extra_data);
        $this->load_admin_view('admin/karyawan/penggajian', $data);
    }

    /**
     * Get comprehensive salary data including overtime and performance
     */
    private function get_salary_data($bulan, $karyawan_id = '', $jabatan_id = '')
    {
        // Standard Payroll Period: 26th prev - 25th current
        $range = $this->_get_payroll_range($bulan);
        $start_date = $range['start'];
        $end_date = $range['end'];

        // Base query for employee data
        $this->db->select('
                k.karyawan_id,
                k.nama_lengkap,
                k.nik,
                k.gaji_pokok as individual_gaji,
                k.nominal_lembur as individual_lembur,
                k.tunjangan_jabatan as individual_tunjangan_jabatan,
                k.jenis_gaji,
                k.status_karyawan,
                k.transport_aktif,
                j.nama_jabatan,
                j.tunjangan_jabatan as default_tunjangan_jabatan,
                k.telepon,
                k.perusahaan_id,
                o.operator_nama as divisi_nama,
                p.nama_perusahaan
            ');
        $this->db->from('tbl_karyawan k');
        $this->db->join('tbl_jabatan j', 'j.jabatan_id = k.jabatan_id', 'left');
        $this->db->join('tbl_operator o', 'o.operator_id = k.divisi_id', 'left');
        $this->db->join('tbl_perusahaan p', 'p.id_perusahaan = k.perusahaan_id', 'left');

        // Apply filters
        if ($karyawan_id) {
            $this->db->where('k.karyawan_id', $karyawan_id);
        }
        if ($jabatan_id) {
            $this->db->where('k.jabatan_id', $jabatan_id);
        }

        // Standard Payroll Exclusions: No Owners/Directors, No Terminals
        $this->db->where('k.divisi_id !=', 8);
        $this->db->where_not_in('k.jabatan_id', [1, 2, 3]);
        $this->db->where('k.nama_lengkap NOT LIKE', '%Terminal%');

        $this->db->order_by('k.nama_lengkap', 'ASC');

        $employees = $this->db->get()->result();


        // Get performance data for all employees in one go
        $performance_data = $this->get_performance_data($bulan, '', '', $start_date, $end_date);
        $performance_map = array();
        foreach ($performance_data as $p) {
            $performance_map[$p->karyawan_id] = $p;
        }

        $salary_data = array();

        // Get holiday dates for this month to identify off-day overtime
        $holidays = $this->db->select('tanggal')->where('tanggal >=', $start_date)->where('tanggal <=', $end_date)->get('hari_libur')->result_array();
        $holiday_dates = array_column($holidays, 'tanggal');

        foreach ($employees as $emp) {
            // Get performance from map
            $perf = isset($performance_map[$emp->karyawan_id]) ? $performance_map[$emp->karyawan_id] : (object) [
                'total_hadir' => 0,
                'total_telat' => 0,
                'total_sakit' => 0,
                'total_izin' => 0,
                'total_alpha' => 0,
                'total_detik_telat' => 0,
                'skor_kinerja' => 0
            ];

            // 1. LEMBUR KERJAAN (From tbl_lembur - Approved specific tasks)
            // Synchronize with attendance logic to pay only for real hours attended
            $this->db->select('tanggal, jam_mulai, jam_selesai, kegiatan');
            $this->db->from('tbl_lembur');
            $this->db->where('karyawan_id', $emp->karyawan_id);
            $this->db->where('status', 'disetujui');
            $this->db->where('tanggal >=', $start_date);
            $this->db->where('tanggal <=', $end_date);
            $overtime_records = $this->db->get()->result();

            // Pre-fetch attendance map for this employee for rapid lookup
            $employee_attendance = $this->db->get_where('absensi', [
                'karyawan_id' => $emp->karyawan_id,
                'tanggal >=' => $start_date,
                'tanggal <=' => $end_date
            ])->result();
            $att_map_local = [];
            foreach ($employee_attendance as $at) {
                $att_map_local[$at->tanggal] = $at;
            }

            $weighted_jam_kerjaan = 0;
            $raw_jam_kerjaan = 0;
            $records_kerjaan = [];

            // --- Overtime Logic Helper (Discrete Jumping) ---
            $calc_jumping_local = function ($minutes, $multiplier) {
                $hours = floor($minutes / 60);
                $rem = $minutes % 60;
                if ($multiplier == 1.0)
                    return $hours + ($rem > 30 ? 0.5 : 0);
                if ($multiplier == 1.5) {
                    if ($hours == 0)
                        return ($rem > 30 ? 1.5 : 0);
                    return 1.5 + ($hours - 1) * 1.5 + ($rem > 30 ? 0.5 : 0);
                }
                if ($multiplier == 2.0)
                    return ($hours * 2.0) + ($rem > 30 ? 1.0 : 0);
                return 0;
            };

            foreach ($overtime_records as $rec) {
                $rec_date = $rec->tanggal;
                $day_num = date('N', strtotime($rec_date)); // 1 (Mon) - 7 (Sun)
                $isHoliday = in_array($rec_date, $holiday_dates);
                $isRamadhan = (strtotime($rec_date) >= strtotime("2026-02-18") && strtotime($rec_date) <= strtotime("2026-03-19"));

                $start_spl = strtotime($rec_date . ' ' . $rec->jam_mulai);
                $end_spl = strtotime($rec_date . ' ' . $rec->jam_selesai);
                if ($end_spl < $start_spl)
                    $end_spl += 86400; // Handle overnight overtime

                // Actual clock out for validation
                $att = isset($att_map_local[$rec_date]) ? $att_map_local[$rec_date] : null;
                $has_valid_checkout = ($att && isset($att->jam_pulang) && $att->jam_pulang != '00:00:00');
                $jam_pulang_real = $has_valid_checkout ? strtotime($rec_date . ' ' . $att->jam_pulang) : $start_spl;

                // 1. Morning Logic (Linear multiplier 1.5x)
                if ($day_num <= 5 && !$isHoliday && strtotime($rec->jam_mulai) < strtotime("12:00:00")) {
                    $pagi_start_limit = strtotime($rec_date . ' 06:00:00');
                    $pagi_end_limit = strtotime($rec_date . ' 08:00:00');
                    $p_start = max($start_spl, $pagi_start_limit);
                    $p_end = min($end_spl, $pagi_end_limit);
                    if ($p_end > $p_start) {
                        $weighted_jam_kerjaan += (($p_end - $p_start) / 3600) * 1.5;
                    }
                }

                // 2. Afternoon/Evening Task Overtime
                $w_end_hour_task = ($day_num == 6) ? 17 : 18;
                $k_start_threshold = strtotime($rec_date . " $w_end_hour_task:01:00");

                if ($day_num == 7 || $isHoliday) {
                    $k_start = $start_spl;
                    $k_end = $end_spl;
                    if ($k_end > $k_start) {
                        $weighted_jam_kerjaan += (($k_end - $k_start) / 3600) * 2.0;
                    }
                } else {
                    $k_start = $k_start_threshold;
                    $k_end = $end_spl;
                    if ($k_end > $k_start) {
                        $task_min = floor(($k_end - $k_start) / 60);
                        // Tier 1 (120 min @ 1.5x block jumping)
                        $t1_min = min($task_min, 120);
                        $weighted_jam_kerjaan += $calc_jumping_local($t1_min, 1.5);
                        // Tier 2 (>120 min @ 2.0x block jumping)
                        if ($task_min > 120) {
                            $t2_min = $task_min - 120;
                            $weighted_jam_kerjaan += $calc_jumping_local($t2_min, 2.0);
                        }
                    }
                }

                // For records/metadata
                $duration_raw = ($end_spl - $start_spl) / 3600;
                $raw_jam_kerjaan += $duration_raw;
                $records_kerjaan[] = [
                    'tgl' => date('d/m', strtotime($rec_date)),
                    'jam' => $rec->jam_mulai . '-' . $rec->jam_selesai,
                    'durasi' => round($duration_raw, 2),
                    'info' => $rec->kegiatan
                ];
            }

            // Calculate salary components
            // Get performance metrics early for calculations
            $total_hadir = $perf->total_hadir;
            $total_alpha = $perf->total_alpha;
            $skor_kinerja = $perf->skor_kinerja;

            // Base Salary from individual settings (Priority: Harian vs Bulanan)
            $gaji_pokok = $emp->individual_gaji ?? 0;
            // ERP EXPERT LOGIC: Calculate salary based on 'jenis_gaji' (Bulanan vs Harian)
            if (isset($emp->jenis_gaji) && $emp->jenis_gaji == 'Harian') {
                $gaji_pokok = $gaji_pokok * $total_hadir;
            }

            // Get Overtime Rates
            // Priority: Individual Setting > Hardcoded Defaults
            $rate_lembur_wajib = (isset($emp->individual_lembur) && $emp->individual_lembur > 0) ? $emp->individual_lembur : 10000;
            $rate_lembur_kerjaan = (isset($emp->individual_lembur) && $emp->individual_lembur > 0) ? $emp->individual_lembur : 12500;

            // Calculate Kerjaan value
            $total_jam_lembur_kerjaan = round($raw_jam_kerjaan, 2);
            $uang_lembur_kerjaan = $weighted_jam_kerjaan * $rate_lembur_kerjaan;

            // 2. LEMBUR WAJIB (From Absensi - Staying until 18:00/17:00 policy)
            // Rule: Mon-Fri (16:00-18:00 limit), Sat (15:00-17:00 limit)
            $this->db->select('tanggal, jam_pulang');
            $this->db->from('absensi');
            $this->db->where('karyawan_id', $emp->karyawan_id);
            $this->db->where('tanggal >=', $start_date);
            $this->db->where('tanggal <=', $end_date);
            $this->db->where('jam_pulang !=', '00:00:00');
            $this->db->where('status', 'Hadir'); // Only calculate for daily presence
            $attendance_records = $this->db->get()->result();

            $total_jam_lembur_wajib = 0;
            $records_wajib = [];

            foreach ($attendance_records as $att) {
                $day_of_week = date('N', strtotime($att->tanggal));
                $pulang_timestamp = strtotime($att->tanggal . ' ' . $att->jam_pulang);
                $daily_wajib = 0;

                // Mon-Fri (1-5): 16:00 - 18:00 (Ramadhan 17:00 - 18:00)
                if ($day_of_week >= 1 && $day_of_week <= 5) {
                    $is_ramadhan = (strtotime($att->tanggal) >= strtotime("2026-02-21") && strtotime($att->tanggal) <= strtotime("2026-03-19"));
                    $start_hour = $is_ramadhan ? '17:00:00' : '16:00:00';

                    $start_limit = $is_ramadhan ? strtotime($att->tanggal . ' 17:00:00') : strtotime($att->tanggal . ' 16:00:00');
                    $end_limit = strtotime($att->tanggal . ' 18:00:00');
                    if ($pulang_timestamp > $start_limit) {
                        $calc_end = min($pulang_timestamp, $end_limit);
                        $w_min = floor(($calc_end - $start_limit) / 60);
                        $daily_wajib = $calc_jumping_local($w_min, 1.0);
                    }
                }
                // Saturday (6): 15:00 - 17:00
                elseif ($day_of_week == 6) {
                    $start_limit = strtotime($att->tanggal . ' 15:00:00');
                    $end_limit = strtotime($att->tanggal . ' 17:00:00');
                    if ($pulang_timestamp > $start_limit) {
                        $calc_end = min($pulang_timestamp, $end_limit);
                        $w_min = floor(($calc_end - $start_limit) / 60);
                        $daily_wajib = $calc_jumping_local($w_min, 1.0);
                    }
                }

                if ($daily_wajib > 0) {
                    $total_jam_lembur_wajib += $daily_wajib;
                    $records_wajib[] = [
                        'tgl' => date('d/m', strtotime($att->tanggal)),
                        'jam' => $att->jam_pulang,
                        'durasi' => round($daily_wajib, 2)
                    ];
                }
            }
            $total_jam_lembur_wajib = round($total_jam_lembur_wajib, 2);
            $uang_lembur_wajib = $total_jam_lembur_wajib * $rate_lembur_wajib;

            // Tunjangan Jabatan (Prioritize individual override from tbl_karyawan)
            $tunjangan_jabatan = ($emp->individual_tunjangan_jabatan > 0) ? $emp->individual_tunjangan_jabatan : ($emp->default_tunjangan_jabatan ?: 0);

            // Dynamic Transport Allowance: (5% of Basic Salary / 26 days) * actual attendance (IF ACTIVE)
            $tunjangan_transportasi = 0;
            if (isset($emp->transport_aktif) && $emp->transport_aktif == 1) {
                $full_transport = $gaji_pokok * 0.05;
                $presence_count = $total_hadir; // Use the same total_hadir used for display
                $tunjangan_transportasi = ($full_transport / 26) * $presence_count;
                $tunjangan_transportasi = round($tunjangan_transportasi);
            }


            // Overtime Calculation 
            // 1. Lembur Kerjaan (Weighted by multipliers)
            // 2. Lembur Wajib (1.0x rate)
            $uang_lembur = $uang_lembur_kerjaan + $uang_lembur_wajib;
            $total_jam_lembur = $total_jam_lembur_kerjaan + $total_jam_lembur_wajib;

            // NEW: Get Meal Allowance from approved overtime
            $biaya_makan_lembur = $this->get_meal_allowance($emp->karyawan_id, $bulan, $start_date, $end_date);

            // NEW: Get Manual Payroll Adjustments
            $manual_payroll = $this->get_manual_payroll($emp->karyawan_id, $bulan, $start_date, $end_date);
            $reward = $manual_payroll->reward;
            $bpjs = $manual_payroll->bpjs;
            $tunjangan_extra = $manual_payroll->tunjangan_extra;
            $tunjangan_kinerja_manual = $manual_payroll->tunjangan_kinerja_manual;
            $kasbon = $manual_payroll->kasbon;
            $pinjaman = $manual_payroll->pinjaman;

            // NEW: Automated Lateness Penalty based on formula: (Gaji Pokok / 26 / 8) * total_jam_telat
            $total_jam_telat = ($perf->total_detik_telat ?? 0) / 3600;
            $rate_per_jam = ($gaji_pokok / 26) / 8;
            $potongan_terlambat = round($rate_per_jam * $total_jam_telat);

            // Legacy/Manual Lateness Penalty (Optional: can be added to the calculated one if needed)
            $potongan_terlambat_manual = $this->get_lateness_penalty($emp->karyawan_id, $bulan, $start_date, $end_date);
            $potongan_terlambat += $potongan_terlambat_manual;

            // Performance bonus calculation (commented out - can be enabled later)
            $bonus_kinerja = 0; // $skor_kinerja * 100; // 100 rupiah per poin

            // Attendance bonus/penalty (commented out - can be enabled later)
            $bonus_kehadiran = 0; // $total_hadir * 5000; // 5000 per hari hadir
            // NEW: Automated Absence Penalty based on formula: (Gaji Pokok / 26) * total_days_alpha
            $rate_absen = $gaji_pokok / 26;
            $potongan_alpha = round($rate_absen * $perf->total_alpha);

            // Total salary calculation (Enhanced)
            // DITERIMA (+): Gaji Pokok, Tunj. Jabatan, Tunj. Transport, Lembur, Biaya Makan, Reward, BPJS, Tunj. Extra, Tunj. Kinerja Manual, Bonus
            // DIKURANGI (-): Kasbon, Pot. Terlambat, Pot. Alpha
            $total_gaji = $gaji_pokok
                + $tunjangan_jabatan
                + $tunjangan_transportasi
                + $uang_lembur
                + $biaya_makan_lembur
                + $reward
                + $bpjs
                + $tunjangan_extra
                + $tunjangan_kinerja_manual
                + $bonus_kinerja
                + $bonus_kehadiran
                - $potongan_alpha
                - $kasbon
                - $pinjaman
                - $potongan_terlambat;

            // Check for manual overrides (legacy support for tbl_gaji_manual)
            $manual = $this->db->get_where('tbl_gaji_manual', [
                'karyawan_id' => $emp->karyawan_id,
                'bulan' => $bulan
            ])->row();

            $is_manual = false;
            if ($manual) {
                $gaji_pokok = $manual->gaji_pokok;
                $tunjangan_jabatan = $manual->tunjangan_jabatan;
                $tunjangan_transportasi = $manual->tunjangan_transportasi;
                $uang_lembur = $manual->uang_lembur;
                $bonus_kinerja = $manual->bonus_kinerja;
                $bonus_kehadiran = $manual->bonus_kehadiran;
                $potongan_alpha = $manual->potongan_alpha;
                $kasbon = isset($manual->kasbon) ? $manual->kasbon : 0;
                $total_gaji = $manual->total_gaji;

                $biaya_makan_lembur = isset($manual->biaya_makan_lembur) ? $manual->biaya_makan_lembur : 0;
                $reward = isset($manual->reward) ? $manual->reward : 0;
                $bpjs = isset($manual->bpjs) ? $manual->bpjs : 0;
                $tunjangan_extra = isset($manual->tunjangan_extra) ? $manual->tunjangan_extra : 0;
                $tunjangan_kinerja_manual = isset($manual->tunjangan_kinerja_manual) ? $manual->tunjangan_kinerja_manual : 0;
                $potongan_terlambat = isset($manual->potongan_terlambat) ? $manual->potongan_terlambat : 0;
                $pinjaman = isset($manual->pinjaman) ? $manual->pinjaman : 0;

                $is_manual = true;
            }

            $salary_data[] = array(
                'is_manual' => $is_manual,
                'karyawan_id' => $emp->karyawan_id,
                'nama_lengkap' => $emp->nama_lengkap,
                'nik' => $emp->nik,
                'telepon' => $emp->telepon,
                'nama_jabatan' => $emp->nama_jabatan,
                'divisi_nama' => $emp->divisi_nama,
                'perusahaan_id' => $emp->perusahaan_id,
                'nama_perusahaan' => $emp->nama_perusahaan,
                'jenis_gaji' => $emp->jenis_gaji,
                'status_karyawan' => $emp->status_karyawan,
                'gaji_pokok' => $gaji_pokok,
                'tunjangan_jabatan' => $tunjangan_jabatan,
                'tunjangan_transportasi' => $tunjangan_transportasi,
                'total_jam_lembur' => $total_jam_lembur,
                'detail_lembur' => [
                    'kerjaan' => [
                        'jam' => $total_jam_lembur_kerjaan,
                        'weighted_jam' => $weighted_jam_kerjaan,
                        'rate' => $rate_lembur_kerjaan,
                        'total' => $uang_lembur_kerjaan,
                        'records' => $records_kerjaan
                    ],
                    'wajib' => [
                        'jam' => $total_jam_lembur_wajib,
                        'rate' => $rate_lembur_wajib,
                        'total' => $uang_lembur_wajib,
                        'records' => $records_wajib
                    ]
                ],
                'jumlah_lembur' => count($overtime_records),
                'uang_lembur' => $uang_lembur,
                // NEW COMPONENTS
                'biaya_makan_lembur' => $biaya_makan_lembur,
                'reward' => $reward,
                'bpjs' => $bpjs,
                'tunjangan_extra' => $tunjangan_extra,
                'tunjangan_kinerja_manual' => $tunjangan_kinerja_manual,
                'potongan_terlambat' => $potongan_terlambat,
                // EXISTING COMPONENTS
                'skor_kinerja' => $skor_kinerja,
                'bonus_kinerja' => $bonus_kinerja,
                'total_hadir' => $total_hadir,
                'total_alpha' => $total_alpha,
                'total_detik_telat' => $perf->total_detik_telat ?? 0,
                'bonus_kehadiran' => $bonus_kehadiran,
                'potongan_alpha' => $potongan_alpha,
                'kasbon' => $kasbon,
                'pinjaman' => $pinjaman,
                'total_gaji' => $total_gaji,
                'total_telat' => $perf->total_telat,
                'total_sakit' => $perf->total_sakit,
                'total_izin' => $perf->total_izin
            );
        }

        // Sort by employee name A-Z
        usort($salary_data, function ($a, $b) {
            return strcmp($a['nama_lengkap'], $b['nama_lengkap']);
        });

        return $salary_data;
    }

    /**
     * Get salary statistics
     */
    private function get_salary_stats($bulan)
    {
        $salary_data = $this->get_salary_data($bulan);

        $total_employees = count($salary_data);
        $total_salary = 0;
        $total_overtime = 0;
        $total_performance_bonus = 0;
        $total_attendance_bonus = 0;
        $total_alpha_penalty = 0;

        foreach ($salary_data as $salary) {
            $total_salary += $salary['total_gaji'];
            $total_overtime += $salary['uang_lembur'];
            $total_performance_bonus += $salary['bonus_kinerja'];
            $total_attendance_bonus += $salary['bonus_kehadiran'];
            $total_alpha_penalty += $salary['potongan_alpha'];
        }

        $avg_salary = $total_employees > 0 ? $total_salary / $total_employees : 0;

        return array(
            'total_employees' => $total_employees,
            'total_salary' => $total_salary,
            'avg_salary' => round($avg_salary, 0),
            'total_overtime' => $total_overtime,
            'total_performance_bonus' => $total_performance_bonus,
            'total_attendance_bonus' => $total_attendance_bonus,
            'total_alpha_penalty' => $total_alpha_penalty
        );
    }

    /**
     * Get detailed salary for specific employee
     */
    public function detail_penggajian($karyawan_id)
    {
        $bulan = $this->input->get('bulan') ?: date('Y-m');

        $range = $this->_get_payroll_range($bulan);

        $extra_data = array(
            'karyawan' => $this->db->select('k.*, j.nama_jabatan, j.gaji_pokok as default_gaji, j.tunjangan_jabatan as default_tunjangan_jabatan, k.tunjangan_jabatan as individual_tunjangan_jabatan, d.operator_nama as divisi_nama, p.nama_perusahaan')
                ->from('tbl_karyawan k')
                ->join('tbl_jabatan j', 'j.jabatan_id = k.jabatan_id', 'left')
                ->join('tbl_operator d', 'd.operator_id = k.divisi_id', 'left')
                ->join('tbl_perusahaan p', 'p.id_perusahaan = k.perusahaan_id', 'left')
                ->where('k.karyawan_id', $karyawan_id)
                ->get()->row(),
            'overtime_details' => $this->db->where('karyawan_id', $karyawan_id)
                ->where('status', 'disetujui')
                ->where('tanggal >=', $range['start'])
                ->where('tanggal <=', $range['end'])
                ->order_by('tanggal', 'ASC')
                ->get('tbl_lembur')->result(),
            'performance' => $this->get_performance_data($bulan, $karyawan_id, '', $range['start'], $range['end'])[0] ?? null,
            'attendance_details' => $this->db->where('karyawan_id', $karyawan_id)
                ->where('tanggal >=', $range['start'])
                ->where('tanggal <=', $range['end'])
                ->order_by('tanggal', 'ASC')
                ->get('absensi')->result(),
            'bulan' => $bulan,
            'payroll_range' => $range,
        );

        $data = $this->_prepare_view_data('Detail Penggajian Karyawan', $extra_data);
        $this->load_admin_view('admin/karyawan/detail_penggajian', $data);
    }

    /**
     * Export salary data to Excel
     */
    public function export_penggajian_excel()
    {
        $bulan = $this->input->get('bulan') ? $this->input->get('bulan') : date('Y-m');
        $karyawan_id = $this->input->get('karyawan_id') ? $this->input->get('karyawan_id') : '';
        $jabatan_id = $this->input->get('jabatan_id') ? $this->input->get('jabatan_id') : '';

        $salary_data = $this->get_salary_data($bulan, $karyawan_id, $jabatan_id);

        // Set headers for Excel download
        header('Content-Type: application/vnd.ms-excel');
        header('Content-Disposition: attachment; filename="laporan_penggajian_' . $bulan . '.xls"');

        $this->load->view('admin/karyawan/export_penggajian_excel', array(
            'salary_data' => $salary_data,
            'bulan' => $bulan
        ));
    }


    public function absen_lembur()
    {
        $bulan = $this->input->get('bulan') ?: date('Y-m');
        $range = $this->_get_payroll_range($bulan);
        $start_date = $range['start'];
        $end_date = $range['end'];

        $tanggal = $this->input->get('tanggal') ?: date('Y-m-d');
        $day_num = date('N', strtotime($tanggal));
        $jk_rule = $this->db->get_where('tbl_jam_kerja', ['urutan' => $day_num])->row();
        $w_start_time_str = ($day_num == 6) ? "15:00:00" : "16:00:00";
        $w_end_time_str = ($jk_rule && $jk_rule->jam_pulang) ? $jk_rule->jam_pulang : (($day_num == 6) ? "17:00:00" : "18:00:00");

        // 1. Fetch all active employees
        $all_employees = $this->db->select('karyawan_id, nama_lengkap, nik, foto, nominal_lembur')
            ->from('tbl_karyawan')
            ->where('nama_lengkap NOT LIKE', '%Terminal%')
            ->get()->result();

        // 2. Fetch SPLs for the selected date - grouped by employee
        $this->db->where('tanggal >=', $start_date);
        $this->db->where('tanggal <=', $end_date);
        $spl_data = $this->db->get('tbl_lembur')->result();
        $spl_grouped = [];
        foreach ($spl_data as $s) {
            $spl_grouped[$s->karyawan_id][] = $s;
        }

        // 3. Fetch Attendance for the selected date
        $this->db->where('tanggal >=', $start_date);
        $this->db->where('tanggal <=', $end_date);
        $absensi_data = $this->db->get('absensi')->result();
        $abs_map = [];
        foreach ($absensi_data as $a) {
            $abs_map[$a->karyawan_id] = $a;
        }

        $final_list = [];

        foreach ($all_employees as $emp) {
            $k_id = $emp->karyawan_id;
            $spls = isset($spl_grouped[$k_id]) ? $spl_grouped[$k_id] : [];
            $att = isset($abs_map[$k_id]) ? $abs_map[$k_id] : null;

            $total_jam_pagi = 0;
            $total_jam_wajib = 0;
            $total_jam_kerjaan = 0;
            $last_spl = null;
            $jam_mulai_kerjaan = '00:00';
            $jam_selesai_kerjaan = '00:00';

            // Calculate Wajib ONCE per day if they attended
            $hitung_wajib = $this->_hitung_jam_lembur($k_id, '00:00', '00:00', $tanggal, $att);
            $total_jam_wajib = $hitung_wajib['breakdown']['wajib'];

            // Calculate Pagi & Kerjaan for each SPL
            foreach ($spls as $spl) {
                $hitung = $this->_hitung_jam_lembur($k_id, $spl->jam_mulai, $spl->jam_selesai, $tanggal, $att);
                // For pagi, we just take the max/flag if it exists once
                if ($hitung['breakdown']['pagi'] > 0)
                    $total_jam_pagi = max($total_jam_pagi, $hitung['breakdown']['pagi']);

                if ($hitung['breakdown']['kerjaan'] > 0) {
                    $total_jam_kerjaan += $hitung['breakdown']['kerjaan'];
                    // Force display exactly after Wajib ends
                    $jam_mulai_kerjaan = date('H:i', strtotime($w_end_time_str) + 60);
                    $jam_selesai_kerjaan = $spl->jam_selesai;
                }
                $last_spl = $spl; // For metadata
            }

            $total_efektif = $total_jam_pagi + $total_jam_wajib + $total_jam_kerjaan;

            // Construct row object for view
            $row = new stdClass();
            $row->id = $last_spl ? $last_spl->id : null; // Reference to one of them
            $row->karyawan_id = $k_id;
            $row->nama_lengkap = $emp->nama_lengkap;
            $row->nik = $emp->nik;
            $row->foto = $emp->foto;
            $row->tanggal = $tanggal;
            $row->jam_mulai = count($spls) > 0 ? $spls[0]->jam_mulai : '00:00';
            $row->jam_selesai = count($spls) > 0 ? $spls[count($spls) - 1]->jam_selesai : ($att ? date('H:i', strtotime($att->jam_pulang)) : '00:00');
            $row->status = count($spls) > 0 ? $spls[0]->status : ($total_efektif > 0 ? 'hadir' : 'tidak lembur');
            $row->kegiatan = count($spls) > 0 ? $spls[0]->kegiatan : ($total_efektif > 0 ? 'Lembur Wajib/Otomatis' : '-');
            $row->foto_kegiatan = count($spls) > 0 ? $spls[0]->foto_kegiatan : null;

            $row->jam_efektif = $total_efektif;
            $row->jam_pagi = $total_jam_pagi;
            $row->jam_wajib = $total_jam_wajib;
            $row->jam_kerjaan = $total_jam_kerjaan;
            $row->jam_mulai_kerjaan = $jam_mulai_kerjaan;
            $row->jam_selesai_kerjaan = $jam_selesai_kerjaan;
            $row->jam_mulai_wajib = $hitung_wajib['wajib_start'];
            $row->jam_selesai_wajib = $hitung_wajib['wajib_end'];
            $row->nominal_rate = $emp->nominal_lembur ?: 0;
            $row->total_lembur = $total_efektif * $row->nominal_rate;

            // Breakdown HTML
            $breakdown_list = [];

            if ($total_jam_pagi > 0) {
                $p_start = date('H:i', max(strtotime($row->jam_mulai), strtotime("06:00")));
                $p_end = date('H:i', min(strtotime($row->jam_selesai), strtotime("08:00")));
                $breakdown_list[] = "- " . $p_start . " s.d " . $p_end . " (" . $total_jam_pagi . "jam)";
            }
            if ($total_jam_wajib > 0 || $total_jam_kerjaan > 0) {
                $m_start = strtotime("$tanggal $w_start_time_str");
                $a_start = date('H:i', max(strtotime($row->jam_mulai), $m_start));
                $a_end = date('H:i', ($att && strtotime($att->jam_pulang) > 0) ? strtotime($att->jam_pulang) : strtotime($row->jam_selesai));

                $combined = $total_jam_wajib + $total_jam_kerjaan;
                if ($combined > 0) {
                    $breakdown_list[] = "- " . $a_start . " s.d " . $a_end . " (" . $combined . "jam)";
                }
            }
            $row->breakdown_html = implode('<br>', $breakdown_list);

            $final_list[] = $row;
        }

        // Sort: show lembur first, then by name
        usort($final_list, function ($a, $b) {
            if ($a->jam_efektif != $b->jam_efektif)
                return $b->jam_efektif <=> $a->jam_efektif;
            return strcmp($a->nama_lengkap, $b->nama_lengkap);
        });

        $extra_data = array(
            'karyawan' => $final_list,
            'jml' => count(array_filter($final_list, function ($x) {
                return $x->jam_efektif > 0;
            })),
            'all_karyawan' => $this->M_master->get_lembur()->result(),
            'listkaryawan' => $this->db->get('tbl_karyawan')->result(),
            'tanggal' => $tanggal
        );

        $data = $this->_prepare_view_data('Daftar Rekap Lembur', $extra_data);
        $this->load_admin_view('admin/karyawan/absen_lembur', $data);
    }

    public function rekap_lembur()
    {
        $tanggal = $this->input->get('tanggal') ?: date('Y-m-d');
        $day_num = date('N', strtotime($tanggal));
        $jk_rule = $this->db->get_where('tbl_jam_kerja', ['urutan' => $day_num])->row();
        $w_start_time_str = ($day_num == 6) ? "15:00:00" : "16:00:00";
        $w_end_time_str = ($jk_rule && $jk_rule->jam_pulang) ? $jk_rule->jam_pulang : (($day_num == 6) ? "17:00:00" : "18:00:00");

        // 1. Fetch all active employees
        $all_employees = $this->db->select('karyawan_id, nama_lengkap, nik, foto, nominal_lembur')
            ->from('tbl_karyawan')
            ->where('nama_lengkap NOT LIKE', '%Terminal%')
            ->get()->result();

        // 2. Fetch SPLs for the selected date - Grouped
        $spl_data = $this->db->get_where('tbl_lembur', ['tanggal' => $tanggal])->result();
        $spl_grouped = [];
        foreach ($spl_data as $s) {
            $spl_grouped[$s->karyawan_id][] = $s;
        }

        // 3. Fetch Attendance
        $absensi_data = $this->db->get_where('absensi', ['tanggal' => $tanggal])->result();
        $abs_map = [];
        foreach ($absensi_data as $a) {
            $abs_map[$a->karyawan_id] = $a;
        }

        $final_list = [];

        foreach ($all_employees as $emp) {
            $k_id = $emp->karyawan_id;
            $spls = isset($spl_grouped[$k_id]) ? $spl_grouped[$k_id] : [];
            $att = isset($abs_map[$k_id]) ? $abs_map[$k_id] : null;

            $total_jam_pagi = 0;
            $total_jam_wajib = 0;
            $total_jam_kerjaan = 0;
            $last_spl = null;
            $jam_mulai_kerjaan = '00:00';
            $jam_selesai_kerjaan = '00:00';

            // Wajib calculation
            $hitung_wajib = $this->_hitung_jam_lembur($k_id, '00:00', '00:00', $tanggal, $att);
            $total_jam_wajib = $hitung_wajib['breakdown']['wajib'];

            // Pagi & Task calculation across all SPLs
            foreach ($spls as $spl) {
                $hitung = $this->_hitung_jam_lembur($k_id, $spl->jam_mulai, $spl->jam_selesai, $tanggal, $att);
                if ($hitung['breakdown']['pagi'] > 0)
                    $total_jam_pagi = max($total_jam_pagi, $hitung['breakdown']['pagi']);

                if ($hitung['breakdown']['kerjaan'] > 0) {
                    $total_jam_kerjaan += $hitung['breakdown']['kerjaan'];
                    // Force display exactly after Wajib ends
                    $jam_mulai_kerjaan = date('H:i', strtotime($w_end_time_str) + 60);
                    $jam_selesai_kerjaan = $spl->jam_selesai;
                }
                $last_spl = $spl;
            }

            $total_efektif = $total_jam_pagi + $total_jam_wajib + $total_jam_kerjaan;

            $row = new stdClass();
            $row->id = $last_spl ? $last_spl->id : null;
            $row->karyawan_id = $k_id;
            $row->nama_lengkap = $emp->nama_lengkap;
            $row->nik = $emp->nik;
            $row->foto = $emp->foto;
            $row->tanggal = $tanggal;
            $row->jam_mulai = count($spls) > 0 ? $spls[0]->jam_mulai : '00:00';
            $row->jam_selesai = count($spls) > 0 ? $spls[count($spls) - 1]->jam_selesai : ($att ? date('H:i', strtotime($att->jam_pulang)) : '00:00');
            $row->status = $last_spl ? $last_spl->status : ($total_efektif > 0 ? 'hadir' : 'tidak lembur');
            $row->kegiatan = count($spls) > 0 ? $spls[0]->kegiatan : ($total_efektif > 0 ? 'Lembur Wajib/Otomatis' : '-');
            $row->foto_kegiatan = count($spls) > 0 ? $spls[0]->foto_kegiatan : null;

            $row->jam_efektif = round($total_efektif, 1);
            $row->jam_pagi = round($total_jam_pagi, 1);
            $row->jam_wajib = round($total_jam_wajib, 1);
            $row->jam_kerjaan = round($total_jam_kerjaan, 1);
            $row->jam_mulai_kerjaan = $jam_mulai_kerjaan;
            $row->jam_selesai_kerjaan = $jam_selesai_kerjaan;
            $row->jam_mulai_wajib = $hitung_wajib['wajib_start'];
            $row->jam_selesai_wajib = $hitung_wajib['wajib_end'];
            $row->nominal_rate = $emp->nominal_lembur ?: 0;
            $row->total_lembur = $row->jam_efektif * $row->nominal_rate;

            // Breakdown HTML
            $breakdown_list = [];

            if ($total_jam_pagi > 0) {
                $p_start = date('H:i', max(strtotime($row->jam_mulai), strtotime("06:00")));
                $p_end = date('H:i', min(strtotime($row->jam_selesai), strtotime("08:00")));
                $breakdown_list[] = "- " . $p_start . " s.d " . $p_end . " (" . $total_jam_pagi . "jam)";
            }
            if ($total_jam_wajib > 0 || $total_jam_kerjaan > 0) {
                $m_start = strtotime("$tanggal $w_start_time_str");
                $a_start = date('H:i', max(strtotime($row->jam_mulai), $m_start));
                $a_end = date('H:i', ($att && strtotime($att->jam_pulang) > 0) ? strtotime($att->jam_pulang) : strtotime($row->jam_selesai));

                $combined = $total_jam_wajib + $total_jam_kerjaan;
                if ($combined > 0) {
                    $breakdown_list[] = "- " . $a_start . " s.d " . $a_end . " (" . $combined . "jam)";
                }
            }
            $row->breakdown_html = implode('<br>', $breakdown_list);

            $final_list[] = $row;
        }

        usort($final_list, function ($a, $b) {
            if ($a->jam_efektif != $b->jam_efektif)
                return $b->jam_efektif <=> $a->jam_efektif;
            return strcmp($a->nama_lengkap, $b->nama_lengkap);
        });

        $extra_data = array(
            'karyawan' => $final_list,
            'jml' => count(array_filter($final_list, function ($x) {
                return $x->jam_efektif > 0;
            })),
            'all_karyawan' => $this->M_master->get_lembur()->result(),
            'listkaryawan' => $this->db->get('tbl_karyawan')->result(),
            'tanggal' => $tanggal
        );

        $data = $this->_prepare_view_data('Daftar Rekap Lembur', $extra_data);
        $this->load_admin_view('admin/karyawan/absen_lembur', $data);
    }

    public function rekap_lembur_bulanan()
    {
        $bulan = $this->input->get('bulan') ?: date('m');
        $tahun = $this->input->get('tahun') ?: date('Y');

        // 1. Fetch Absensi (Primary Source) - Joined with Karyawan
        $this->db->select('a.*, k.nama_lengkap, k.nik, k.foto, k.nominal_lembur');
        $this->db->from('absensi a');
        $this->db->join('tbl_karyawan k', 'a.karyawan_id = k.karyawan_id');
        $this->db->where('MONTH(a.tanggal)', $bulan);
        $this->db->where('YEAR(a.tanggal)', $tahun);
        $this->db->where('a.status', 'Hadir'); // Only calculate for Present days
        $this->db->order_by('k.nama_lengkap', 'ASC');
        $this->db->order_by('a.tanggal', 'ASC');
        $raw_absensi = $this->db->get()->result();

        // 2. Fetch Lembur (SPL) Data for mapping
        $lembur_data = $this->M_master->get_lembur_filter($bulan, $tahun)->result();
        $lembur_map = [];
        foreach ($lembur_data as $l) {
            $lembur_map[$l->karyawan_id . '_' . $l->tanggal] = $l;
        }

        $rekap_karyawan = [];

        // 3. Process Logic
        foreach ($raw_absensi as $row) {
            $k_id = $row->karyawan_id;
            $tgl = $row->tanggal;

            // Initialize Group
            if (!isset($rekap_karyawan[$k_id])) {
                $rekap_karyawan[$k_id] = (object) [
                    'karyawan_id' => $k_id,
                    'nama_lengkap' => $row->nama_lengkap,
                    'nik' => $row->nik,
                    'foto' => $row->foto,
                    'nominal_rate' => $row->nominal_lembur ?: 0,
                    'jam_pagi' => 0,
                    'jam_wajib' => 0,
                    'jam_kerjaan' => 0,
                    'total_jam_efektif' => 0,
                    'total_rupiah' => 0,
                    'jml_hari' => 0,
                    'details' => []
                ];
            }

            // Check for SPL
            $spl = isset($lembur_map[$k_id . '_' . $tgl]) ? $lembur_map[$k_id . '_' . $tgl] : null;
            $jam_mulai_spl = $spl ? $spl->jam_mulai : '00:00';
            $jam_selesai_spl = $spl ? $spl->jam_selesai : '00:00';

            // Calculate Effective Hours
            // Pass the Absensi Row ($row) directly to avoid re-querying
            $hitung = $this->_hitung_jam_lembur($k_id, $jam_mulai_spl, $jam_selesai_spl, $tgl, $row);

            // Accumulate
            $rekap_karyawan[$k_id]->jam_pagi = round($rekap_karyawan[$k_id]->jam_pagi + $hitung['breakdown']['pagi'], 1);
            $rekap_karyawan[$k_id]->jam_wajib = round($rekap_karyawan[$k_id]->jam_wajib + $hitung['breakdown']['wajib'], 1);
            $rekap_karyawan[$k_id]->jam_kerjaan = round($rekap_karyawan[$k_id]->jam_kerjaan + $hitung['breakdown']['kerjaan'], 1);
            $rekap_karyawan[$k_id]->total_jam_efektif = round($rekap_karyawan[$k_id]->total_jam_efektif + $hitung['total'], 1);
            $daily_rupiah = ($hitung['total'] * $rekap_karyawan[$k_id]->nominal_rate);
            $rekap_karyawan[$k_id]->total_rupiah += $daily_rupiah;

            // Store Details
            $rekap_karyawan[$k_id]->details[] = (object) [
                'tanggal' => $tgl,
                'jam_masuk' => $row->jam_masuk,
                'jam_pulang' => $row->jam_pulang,
                'jam_mulai_spl' => $jam_mulai_spl,
                'jam_selesai_spl' => $jam_selesai_spl,
                'pagi' => $hitung['breakdown']['pagi'],
                'wajib' => $hitung['breakdown']['wajib'],
                'kerjaan' => $hitung['breakdown']['kerjaan'],
                'wajib_start' => $hitung['wajib_start'],
                'wajib_end' => $hitung['wajib_end'],
                'total_efektif' => $hitung['total'],
                'rupiah' => $daily_rupiah,
                'keterangan' => ($spl && isset($spl->kegiatan)) ? $spl->kegiatan : '-',
                'foto_kegiatan' => ($spl && isset($spl->foto_kegiatan)) ? $spl->foto_kegiatan : null
            ];

            // Count days if there is any overtime (Wajib OR Kerjaan OR Pagi)
            if ($hitung['total'] > 0) {
                $rekap_karyawan[$k_id]->jml_hari++;
            }
        }

        // Sort by Name (Already sorted by query, but array keys might need indexed reset if views iterate strictly)
        // actually usort is safer if keys are IDs
        usort($rekap_karyawan, function ($a, $b) {
            return strcmp($a->nama_lengkap, $b->nama_lengkap);
        });

        $extra_data = array(
            'karyawan' => $rekap_karyawan,
            'jml' => count($rekap_karyawan),
            'total_karyawan' => count($rekap_karyawan),
            'bulan' => $bulan,
            'tahun' => $tahun
        );

        $data = $this->_prepare_view_data('Rekap Lembur Bulanan', $extra_data);
        $this->load_admin_view('admin/karyawan/rekap_lembur_bulanan', $data);
    }

    private function _hitung_jam_lembur($karyawan_id, $jam_mulai, $jam_selesai, $tanggal, $absensi_data = null)
    {
        // Parse time SPL (Surat Perintah Lembur)
        $start_spl = strtotime("$tanggal $jam_mulai");
        $end_spl = strtotime("$tanggal $jam_selesai");

        if ($end_spl < $start_spl) {
            $end_spl += 86400; // Handle cross midnight
        }

        // Get Actual Clock Out from Attendance for "Lembur Wajib"
        if ($absensi_data) {
            $absensi = $absensi_data;
        } else {
            $absensi = $this->db->get_where('absensi', [
                'karyawan_id' => $karyawan_id,
                'tanggal' => $tanggal
            ])->row();
        }

        // Use Absensi Jam Pulang, fallback to SPL start if missing (redundant safety)
        $jam_pulang_real = (isset($absensi->jam_pulang) && $absensi->jam_pulang != '00:00:00') ? strtotime("$tanggal $absensi->jam_pulang") : $start_spl;

        $day_num = date('N', strtotime($tanggal)); // 1 (Mon) - 7 (Sun)
        $breakdown = [
            'pagi' => 0,
            'wajib' => 0,
            'kerjaan' => 0
        ];

        // Helper for Step-Based Jumping Logic (Discrete Blocks)
        $calc_jumping = function ($minutes, $multiplier) {
            $hours = floor($minutes / 60);
            $rem = $minutes % 60;

            if ($multiplier == 1.0) {
                // Mandatory (1.0x): 31-60m -> +0.5
                return $hours + ($rem > 30 ? 0.5 : 0);
            } elseif ($multiplier == 1.5) {
                // Task T1 (1.5x): First block (>30m) jumps to 1.5. Subsequent blocks (>30m) add 0.5
                if ($hours == 0)
                    return ($rem > 30 ? 1.5 : 0);
                return 1.5 + ($hours - 1) * 1.5 + ($rem > 30 ? 0.5 : 0);
            } elseif ($multiplier == 2.0) {
                // Task T2 (2.0x): 31-60m -> +1.0 (Discrete 1.0 per 30 min block)
                return ($hours * 2.0) + ($rem > 30 ? 1.0 : 0);
            }
            return 0;
        };

        // --- Morning Logic (06:00 - 08:00) ---
        if ($day_num <= 5 && $jam_mulai != '00:00' && strtotime($jam_mulai) < strtotime("12:00:00")) {
            $pagi_start_limit = strtotime("$tanggal 06:00:00");
            $pagi_end_limit = strtotime("$tanggal 08:00:00");
            $p_start = max($start_spl, $pagi_start_limit);
            $p_end = min($end_spl, $pagi_end_limit);
            if ($p_end > $p_start) {
                $breakdown['pagi'] = (($p_end - $p_start) / 3600) * 1.5;
            }
        }

        // Fetch Dynamic End Time (Limit) from tbl_jam_kerja
        static $jk_cache = [];
        if (!isset($jk_cache[$day_num])) {
            $jk_cache[$day_num] = $this->db->get_where('tbl_jam_kerja', ['urutan' => $day_num])->row();
        }
        $jk = $jk_cache[$day_num];

        // Start Wajib is fixed, End Wajib is dynamic from DB
        $w_start_time_str = ($day_num == 6) ? "15:00:00" : "16:00:00";
        $w_end_time_str = ($jk && $jk->jam_pulang) ? $jk->jam_pulang : (($day_num == 6) ? "17:00:00" : "18:00:00");

        // 1. Lembur Wajib (Based on Absensi Pulang)
        if ($day_num <= 6) {
            $w_start = strtotime("$tanggal $w_start_time_str");
            $w_end_limit = strtotime("$tanggal $w_end_time_str");
            $w_actual_end = min($jam_pulang_real, $w_end_limit);
            if ($w_actual_end > $w_start) {
                $raw_min = floor(($w_actual_end - $w_start) / 60);
                $breakdown['wajib'] = $calc_jumping($raw_min, 1.0);
            }
        }

        // 2. Lembur Kerjaan (Based on SPL) - Starts after Wajib ends
        $k_start = strtotime("$tanggal $w_end_time_str") + 60; // Add 1 minute buffer (e.g., 17:01 or 18:01)
        $is_evening_spl = ($jam_mulai != '00:00' && strtotime($jam_mulai) >= strtotime("12:00:00"));

        if ($is_evening_spl) {
            $k_end = $end_spl;
            if ($k_end > $k_start) {
                $task_min = floor(($k_end - $k_start) / 60);
                $t1_min = min($task_min, 120);
                $breakdown['kerjaan'] += $calc_jumping($t1_min, 1.5);
                if ($task_min > 120) {
                    $t2_min = $task_min - 120;
                    $breakdown['kerjaan'] += $calc_jumping($t2_min, 2.0);
                }
            }
        }

        $total_efektif = $breakdown['pagi'] + $breakdown['wajib'] + $breakdown['kerjaan'];
        return [
            'total' => round($total_efektif, 1),
            'breakdown' => [
                'pagi' => round($breakdown['pagi'], 1),
                'wajib' => round($breakdown['wajib'], 1),
                'kerjaan' => round($breakdown['kerjaan'], 1)
            ],
            'wajib_start' => ($breakdown['wajib'] > 0) ? date('H:i', strtotime("$tanggal $w_start_time_str")) : '00:00',
            'wajib_end' => ($breakdown['wajib'] > 0) ? date('H:i', $w_actual_end) : '00:00'
        ];
    }


