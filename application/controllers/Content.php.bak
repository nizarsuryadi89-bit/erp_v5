<?php
defined('BASEPATH') OR exit('No direct script access allowed');

/**
 * Controller Content - Manajemen Konten Sistem
 * 
 * Controller ini menangani manajemen konten sistem termasuk:
 * - Panduan/workflow sistem
 * - Pengumuman/announcements
 * 
 * @author TGM ERP System
 * @version 1.0
 */
class Content extends MY_Controller
{
    public function __construct()
    {
        parent::__construct();
    }

    /**
     * Default index - redirect to pengumuman management
     */
    public function index()
    {
        redirect('content/pengumuman');
    }

    // =====================================================
    // PANDUAN / WORKFLOW SECTION
    // =====================================================

    /**
     * Display user guide and workflow documentation
     */
    public function panduan()
    {
        $data = $this->_get_common_data('Alur Kerja & Panduan Sistem');
        $this->load_admin_view('admin/panduan/index', $data);
    }

    // =====================================================
    // PENGUMUMAN / ANNOUNCEMENTS SECTION
    // =====================================================

    /**
     * Display announcements management page
     * Only accessible by Administrator (level 1) and Owner (level 17)
     */
    public function pengumuman()
    {
        // Check access permission
        $level = (int) $this->session->userdata('level');
        if (!in_array($level, [1, 17])) {
            $this->session->set_flashdata('error', 'Akses ditolak. Anda tidak memiliki izin untuk mengelola pengumuman.');
            redirect('dashboard');
        }

        $data = $this->_get_common_data('Manajemen Pengumuman');
        $data['pengumuman'] = $this->db->select('p.*, u.username as pembuat')
            ->from('tbl_pengumuman p')
            ->join('users u', 'u.user_id = p.user_id', 'left')
            ->order_by('p.created_at', 'DESC')
            ->get()->result();

        $this->load_admin_view('admin/pengumuman/index', $data);
    }

    /**
     * Save or update announcement
     */
    public function simpan_pengumuman()
    {
        // Check access permission
        $level = (int) $this->session->userdata('level');
        if (!in_array($level, [1, 17])) {
            $this->session->set_flashdata('error', 'Akses ditolak.');
            redirect('dashboard');
        }

        // Gunakan post(key, true) untuk filter XSS pada teks biasa
        $judul = $this->input->post('judul', true);
        // post(key, false) untuk mencegah tag HTML dirusak jika menggunakan Rich Text Editor
        $isi = $this->input->post('isi', false);
        $kategori = $this->input->post('kategori', true);
        $tanggal_mulai = $this->input->post('tanggal_mulai', true);
        $tanggal_selesai = $this->input->post('tanggal_selesai', true);
        $status = $this->input->post('status', true) ? 1 : 0;
        $id = $this->input->post('id', true);

        // Validasi wajib isi
        if (empty($judul) || empty($isi)) {
            $this->session->set_flashdata('error', 'Judul dan Isi pengumuman wajib diisi.');
            redirect('content/pengumuman');
            return;
        }

        $data = [
            'judul' => $judul,
            'isi' => $isi,
            'kategori' => $kategori,
            'tanggal_mulai' => $tanggal_mulai,
            'tanggal_selesai' => $tanggal_selesai,
            'user_id' => $this->session->userdata('id'),
            'perusahaan_id' => $this->session->userdata('perusahaan_id'),
            'status' => $status
        ];

        if (!empty($id)) {
            $this->db->where('id', $id);
            $this->db->update('tbl_pengumuman', $data);
            $this->session->set_flashdata('success', 'Pengumuman berhasil diperbarui.');
        } else {
            $this->db->insert('tbl_pengumuman', $data);
            $this->session->set_flashdata('success', 'Pengumuman baru berhasil dipublikasikan.');
        }

        redirect('content/pengumuman');
    }

    /**
     * Delete announcement
     * 
     * @param int $id Announcement ID
     */
    public function hapus_pengumuman($id)
    {
        // Check access permission
        $level = (int) $this->session->userdata('level');
        if (!in_array($level, [1, 17])) {
            $this->session->set_flashdata('error', 'Akses ditolak.');
            redirect('dashboard');
        }

        $this->db->where('id', $id);
        $this->db->delete('tbl_pengumuman');
        $this->session->set_flashdata('success', 'Pengumuman telah dihapus.');
        redirect('content/pengumuman');
    }

    /**
     * Get announcement data by ID (AJAX)
     * 
     * @param int $id Announcement ID
     */
    public function get_pengumuman_data($id)
    {
        // Set header JSON agar aman dan rapi
        header('Content-Type: application/json; charset=utf-8');

        // Check access permission (agar tidak sembarang orang bisa inspect/fetch ID)
        $level = (int) $this->session->userdata('level');
        if (!in_array($level, [1, 17])) {
            echo json_encode(['error' => 'Akses ditolak']);
            return;
        }

        $data = $this->db->get_where('tbl_pengumuman', ['id' => $id])->row();
        echo json_encode($data ?: ['error' => 'Not found']);
    }

    // =====================================================
    // HELPER METHODS
    // =====================================================

    /**
     * Get common data for views
     * 
     * @param string $title Page title
     * @return array Common view data
     */
    private function _get_common_data($title)
    {
        $perusahaan_id = $this->session->userdata('perusahaan_id') ?: 1;
        $perusahaan_info = $this->db->get_where('tbl_perusahaan', ['id_perusahaan' => $perusahaan_id])->row_array();

        return [
            'controller' => 'content',
            'function' => $this->uri->segment(2) ?: 'index',
            'title' => $title,
            'perusahaan' => $perusahaan_info['nama_perusahaan'] ?? 'TGM ERP'
        ];
    }
}
