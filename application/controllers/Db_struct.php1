<?php
// application/controllers/Db_struct.php
defined('BASEPATH') OR exit('No direct script access allowed');

class Db_struct extends CI_Controller {
    public function index() {
        header('Content-Type: text/plain');
        $fields = $this->db->list_fields('menu');
        echo "COLUMNS IN 'menu' TABLE:\n";
        foreach ($fields as $field) {
            echo "- $field\n";
        }
        
        echo "\nDATA PREVIEW (1ST ROW):\n";
        $row = $this->db->get('menu', 1)->row_array();
        print_r($row);
    }
}
